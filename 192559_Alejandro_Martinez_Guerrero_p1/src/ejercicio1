public class App {
    public static void main(String[] args) {
a = float(input("Ingrese el primer valor de a: "))
b = float(input("Ingrese el segundo valor de b: "))


if a > b:
    suma = a + b
    diferencia = a - b
    print("Suma:", suma)
    print("Diferencia:", diferencia)
else:
    producto = a * b
    print("Producto:", producto)
    
    if b == 0:
        print("División no definida")
    else:
        division = a / b
        print("División:", division)
}

